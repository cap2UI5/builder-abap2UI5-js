{
  "name": "builder-abap2ui5-js",
  "version": "1.0.0",
  "private": true,
  "description": "abap2UI5 ported to JavaScript — the ABAP→JS transpiler, sync scripts and jest suite that generate the platform-neutral core package in core/ (consumed by the adapters and, downstream, the cap2UI5 CAP app)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/check-no-frozen.js && node scripts/check-doc-numbers.js && jest --config jest.config.js --verbose",
    "test:watch": "jest --config jest.config.js --watch",
    "transpile": "node scripts/abap2js.js",
    "mirror_abap2ui5": "node scripts/mirror-input.js abap2UI5",
    "mirror_app": "node scripts/mirror-input.js app",
    "mirror_samples": "node scripts/mirror-input.js samples",
    "transpile_abap2ui5": "node scripts/transpile-tree.js abap2UI5",
    "transpile_samples": "node scripts/transpile-tree.js samples",
    "prepare_app": "node scripts/prepare-app.js",
    "transpile_tests": "node scripts/transpile-tests.js",
    "run_units": "node scripts/run-units.js",
    "assemble_core": "node scripts/assemble-core.js",
    "publish_core": "node scripts/publish-core.js",
    "build_core": "node scripts/assemble-core.js && node scripts/publish-core.js",
    "coverage": "jest --config jest.config.js --coverage",
    "check_frozen": "node scripts/check-no-frozen.js",
    "check_doc_numbers": "node scripts/check-doc-numbers.js",
    "check_divergence": "node scripts/check-upstream-divergence.js"
  },
  "devDependencies": {
    "@abaplint/core": "^2.120.37",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "jest": "^30.2.0"
  },
  "repository": "github:cap2UI5/builder-abap2UI5-js"
}
